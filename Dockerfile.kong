# Dockerfile.kong
FROM kong:3.3

USER root

# Installation des dépendances système
RUN apt-get update && \
    apt-get install -y --no-install-recommends git unzip && \
    luarocks install --server=https://luarocks.org/manifests/kong lua-resty-openidc 1.7.4-1 && \
    luarocks install --server=https://luarocks.org/manifests/kong kong-oidc && \
    apt-get remove -y git unzip && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

USER kong